# Postgres connection string (Supabase or Neon) — see plan.md Tech Stack / Data storage budget
DATABASE_URL="postgresql://user:password@host:5432/db?schema=public"

# SAM.gov Entity Management API — active Utah business ingestion (free personal key: 10 req/day, 10 records/page)
# Get your key from your SAM.gov account workspace: https://sam.gov (Account Details > Public API Key)
SAM_GOV_API_KEY=""

# Anthropic API — matching, explanation generation, SBIR/STTR autofill drafting,
# and (via the server-side web_search tool) resolving each business's official
# website in /api/enrich
ANTHROPIC_API_KEY=""

# Resend — outreach email send (test inbox / opt-in list only, see plan.md Scope Decisions)
RESEND_API_KEY=""

# Fixed test inbox / opt-in address that ALL outreach emails go to, regardless
# of which business they're about — per Scope Decision 1, the demo send is
# simulated, never a real blast to a business's own contact address.
OUTREACH_TEST_RECIPIENT=""

# Verified Resend sender address. Defaults to onboarding@resend.dev (Resend's
# shared testing address, works without domain verification) if unset.
OUTREACH_FROM_EMAIL=""

# Base URL used to build the tokenized dashboard link in outreach emails.
# Defaults to http://localhost:3000 for local dev; set to the deployed URL
# in production.
APP_BASE_URL=""

# Shared secret checked against the Authorization: Bearer header on /api/ingest
# and /api/sync-opportunities, so Vercel Cron invocations are authenticated.
# Leave unset for local dev (both routes allow unauthenticated requests then).
CRON_SECRET=""
